# Render assigns PORT dynamically, but default is 5000 for local dev
PORT=5000

# MongoDB Atlas Connection URI (can be named MONGO_URI, MONGODB_URI, or MONGODB_ATLAS_URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/academiasync?retryWrites=true&w=majority

# JWT Authentication Secrets & Expiration
JWT_SECRET=super_secret_jwt_key_change_for_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL & Link AES-256-GCM Encryption Key (Must be exactly 32-byte hex string = 64 hex characters)
URL_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Environment
NODE_ENV=production

# CORS: Comma-separated allowed frontend domains (supports localhost and any *.vercel.app automatically)
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# SMTP Email Configuration (Nodemailer)
# Leave empty in local dev to automatically use disposable Ethereal test accounts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM_ADDRESS=notifications@academiasync.edu
EMAIL_FROM_NAME="AcademiaSync Institutional Portal"

